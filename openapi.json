            "title": "Name",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "routeKey": {
            "title": "Routekey",
            "type": "string"
          }
        },
        "required": [
          "routeKey",
          "name",
          "order"
        ],
        "title": "NavigationItemDto",
        "type": "object"
      },
      "PasswordSetDto": {
        "properties": {
          "state": {
            "const": "PASSWORD_SET",
            "default": "PASSWORD_SET",
            "title": "State",
            "type": "string"
          }
        },
        "title": "PasswordSetDto",
        "type": "object"
      },
      "PasswordUpdatedDto": {
        "properties": {
          "state": {
            "const": "PASSWORD_UPDATED_LOGIN_REQUIRED",
            "default": "PASSWORD_UPDATED_LOGIN_REQUIRED",
