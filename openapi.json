            "type": "string"
          }
        },
        "title": "PasswordUpdatedDto",
        "type": "object"
      },
      "PrincipalDto": {
        "properties": {
          "employeeId": {
            "title": "Employeeid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "employeeId",
          "name"
        ],
        "title": "PrincipalDto",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Type"
          }
        },
        "required": [
          "title",
          "status",
          "requestId"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyDto": {
        "properties": {
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
