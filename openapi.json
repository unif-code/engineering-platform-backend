            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "employeeNo",
          "password"
        ],
        "title": "LoginRequestDto",
        "type": "object"
      },
      "NavigationItemDto": {
        "properties": {
